<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/primary"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del equipo"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: -"
                    android:textColor="#B3E5FC"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:id="@+id/viewOnlineIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@color/device_offline" />

        </LinearLayout>

        <!-- Info del equipo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID del dispositivo"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="abc123def456"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvLastSeen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Última conexión: -"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Estado de la tarea en curso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:layout_marginTop="8dp"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tarea en curso"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progressTask"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/installProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:visibility="gone"
                android:layout_marginTop="8dp">
                <ProgressBar
                    android:id="@+id/installProgressRing"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="center"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_ring"
                    android:indeterminate="false" />
                <TextView
                    android:id="@+id/installProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0%"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/installProgressStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Preparando instalación…"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin tareas pendientes"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvTaskResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxLines="8"
                android:scrollbars="vertical" />

        </LinearLayout>

        <!-- Acciones -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSTALAR / GESTIONAR"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnInstallFromStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/install_apk"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:padding="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRefreshApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualizar lista de apps"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:padding="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultar RAM y almacenamiento"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeviceResources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RAM y almacenamiento: sin consultar"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAdbCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar comando ADB"
            android:textColor="@color/white"
            android:backgroundTint="#5146B8"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnReboot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reiniciar equipo"
            android:textColor="@color/white"
            android:backgroundTint="#F44336"
            android:padding="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDeleteDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar equipo de la lista"
            android:textColor="@color/white"
            android:backgroundTint="#9E9E9E"
            android:padding="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Apps instaladas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPS INSTALADAS EN EL EQUIPO"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInstalledApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvNoApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_installed_apps"
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>