<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_margin="4dp"
    android:background="@color/white"
    android:elevation="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Icono de la app -->
    <ImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Icono de app"
        android:src="@android:drawable/ic_menu_info_details" />

    <!-- Info de la app -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Nombre de la App" />

        <TextView
            android:id="@+id/tvPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray"
            android:textSize="12sp"
            android:text="com.example.package" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray"
            android:textSize="11sp"
            android:text="v1.0.0"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Botones de acción -->
    <ImageButton
        android:id="@+id/btnPinApp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_add"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Fijar en launcher"
        android:tint="@color/accent"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btnOpenApp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_play"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Abrir app"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btnParentalApp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_lock_lock"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Control parental"
        android:tint="@color/accent"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btnUninstallApp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Desinstalar app"
        android:tint="@color/error" />

</LinearLayout>