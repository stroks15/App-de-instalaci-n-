<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A">

    <!-- Header profesional -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#16213E">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_lock_lock"
            android:contentDescription="Kiosk" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODO KIOSK ACTIVO"
                android:textColor="#FF9800"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKioskDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipo bloqueado"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnKioskExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salir"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F"
            android:padding="12dp" />

    </LinearLayout>

    <!-- Cuadrícula de apps permitidas -->
    <TextView
        android:id="@+id/tvKioskHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una aplicación con el mando"
        android:textColor="#B0B0B0"
        android:textSize="15sp"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKioskApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="24dp" />

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dexterh4ck Equipos · Modo kiosk"
        android:textColor="#4A4A5A"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="12dp" />

</LinearLayout>