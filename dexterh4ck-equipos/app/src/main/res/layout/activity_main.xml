<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B1220" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⌁  Dexterh4ck Equipos" android:textColor="#F4F7FF"
            android:textSize="27sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Inicia sesión con tu cuenta KioskGrid para registrar este equipo automáticamente."
            android:textColor="#AAB7CA" android:textSize="14sp"
            android:layout_marginTop="5dp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp"
            android:layout_marginTop="14dp" android:background="#151F31">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nombre del equipo" android:textColor="#F4F7FF"
                android:textSize="17sp" android:textStyle="bold" />
            <EditText android:id="@+id/etDeviceName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Ej. Sala principal" android:textColor="#FFFFFF"
                android:textColorHint="#8190A6" android:backgroundTint="#6575A0"
                android:textSize="16sp" android:singleLine="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Correo electrónico" android:textColor="#F4F7FF"
                android:textSize="14sp" android:layout_marginTop="14dp" />
            <EditText android:id="@+id/etEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="usuario@correo.com" android:inputType="textEmailAddress"
                android:textColor="#FFFFFF" android:textColorHint="#8190A6"
                android:backgroundTint="#6575A0" android:singleLine="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Contraseña" android:textColor="#F4F7FF"
                android:textSize="14sp" android:layout_marginTop="10dp" />
            <EditText android:id="@+id/etPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Contraseña de tu cuenta" android:inputType="textPassword"
                android:textColor="#FFFFFF" android:textColorHint="#8190A6"
                android:backgroundTint="#6575A0" android:singleLine="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="URL del servidor" android:textColor="#F4F7FF"
                android:textSize="14sp" android:layout_marginTop="12dp" />
            <EditText android:id="@+id/etServerUrl"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="https://tu-backend.vercel.app" android:inputType="textUri"
                android:textColor="#FFFFFF" android:textColorHint="#8190A6"
                android:backgroundTint="#6575A0" android:textSize="14sp"
                android:singleLine="true" />
            <Button android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Iniciar sesión y registrar equipo" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:backgroundTint="#2459C5"
                android:layout_marginTop="14dp" />
            <TextView android:id="@+id/tvStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Estado: sin iniciar" android:textColor="#57D6A0"
                android:textSize="13sp" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvRamValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="RAM: consultando…" android:textColor="#DCE7F7"
                android:textSize="14sp" android:layout_marginTop="14dp" />
            <TextView android:id="@+id/tvStorageValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Almacenamiento: consultando…" android:textColor="#DCE7F7"
                android:textSize="14sp" android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp"
            android:layout_marginTop="14dp" android:background="#151F31">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Estado de depuración ADB" android:textColor="#F4F7FF"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvAdbStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ADB: comprobando…" android:textColor="#57D6A0"
                android:textSize="14sp" android:layout_marginTop="8dp" />
            <Button android:id="@+id/btnAdbSettings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Activar / configurar depuración ADB"
                android:textAllCaps="false" android:textColor="#FFFFFF"
                android:backgroundTint="#5146B8" android:layout_marginTop="10dp" />
            <Button android:id="@+id/btnDeviceOwner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Activar Device Owner"
                android:textAllCaps="false" android:textColor="#FFFFFF"
                android:backgroundTint="#16865D" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/tvDeviceOwnerStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Device Owner: sin activar"
                android:textColor="#AAB7CA" android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mantén este equipo y tu teléfono conectados a Internet para permitir la gestión remota."
            android:textColor="#8190A6" android:textSize="12sp"
            android:gravity="center" android:padding="16dp" />
    </LinearLayout>
</ScrollView>