<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101827" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="36dp" android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Dexterh4ck Equipos" android:textColor="#FFFFFF" android:textSize="30sp"
            android:textStyle="bold" android:layout_marginBottom="20dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nombre del equipo" android:textColor="#DCE6F2" android:textSize="18sp"/>
        <EditText android:id="@+id/etDeviceName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Ej. Sala principal"
            android:textColor="#FFFFFF" android:textColorHint="#9AA8B8"
            android:backgroundTint="#58A6FF" android:textSize="20sp" android:singleLine="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="URL del backend KioskGrid" android:textColor="#DCE6F2"
            android:textSize="16sp" android:layout_marginTop="18dp"/>
        <EditText android:id="@+id/etServerUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="https://tu-backend.vercel.app"
            android:inputType="textUri" android:textColor="#FFFFFF" android:textColorHint="#9AA8B8"
            android:backgroundTint="#58A6FF" android:textSize="16sp" android:singleLine="true"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Estado: sin iniciar"
            android:textColor="#7EE787" android:textSize="20sp" android:layout_marginTop="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Código de vinculación" android:textColor="#DCE6F2"
            android:textSize="18sp" android:layout_marginTop="22dp"/>
        <TextView android:id="@+id/tvPairingCode" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="-----" android:textColor="#FFCA64"
            android:textSize="38sp" android:textStyle="bold" android:letterSpacing="0.18"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnCopyCode" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Copiar código"
            android:focusable="true" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvAdbStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ADB: comprobando…"
            android:textColor="#DCE6F2" android:textSize="18sp" android:layout_marginTop="26dp"/>
        <Button android:id="@+id/btnAdbSettings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Abrir ajustes de desarrollador"
            android:focusable="true" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Guardar e iniciar agente"
            android:focusable="true" android:layout_marginTop="22dp"/>
    </LinearLayout>
</ScrollView>
