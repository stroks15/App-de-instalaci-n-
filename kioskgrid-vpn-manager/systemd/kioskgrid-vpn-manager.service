[Unit]
Description=KioskGrid WireGuard peer manager
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/kioskgrid-vpn-manager.env
ExecStart=/usr/bin/python3 /opt/kioskgrid-vpn-manager/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kioskgrid-vpn-manager /etc/wireguard

[Install]
WantedBy=multi-user.target
